# Template del env-file de producción.
# Copiar a /etc/align/align.env en el VPS con valores reales:
#   sudo install -m 640 -o root -g align /dev/null /etc/align/align.env
#   sudo nano /etc/align/align.env
# El archivo real NUNCA se commitea. Este .example sí (no tiene valores).
#
# Regla: SOLO VALORES. Config no-secreta (puerto, logging, actuator) va en
# application-prod.properties, que está en git. Ver devops.md.
#
# Sin comillas, sin 'export', sin espacios al final de línea.

SPRING_PROFILES_ACTIVE=prod

# --- Base de datos (Postgres local en el VPS) ---
DB_URL=jdbc:postgresql://localhost:5432/align_db
DB_USER=align
DB_PASSWORD=<password del rol align en Postgres>

# --- JWT ---
# openssl rand -base64 48
JWT_SECRET=<cadena aleatoria 64+ chars>

# --- Web Push (VAPID) ---
# Generar el par con:  npx web-push generate-vapid-keys
# NO reusar las claves de application-dev/ci.properties (están en git).
ALIGN_PUSH_VAPID_PUBLIC_KEY=<clave pública>
ALIGN_PUSH_VAPID_PRIVATE_KEY=<clave privada>
ALIGN_PUSH_VAPID_SUBJECT=mailto:jhontamos@hotmail.com

# --- Cifrado de las API keys de usuarios (BYOK) ---
# Base64 de 16/24/32 bytes:  openssl rand -base64 32
# La app no arranca sin esto. Si cambia, cada usuario debe recargar su API key de Gemini.
ALIGN_CRYPTO_SECRET=<master key AES en Base64>
